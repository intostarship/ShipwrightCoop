static ActorSyncInfo* GetActorSyncInfo(s16 actorId) {
    for (int i = 0; actorSyncRegistry[i].actorId >= 0; i++) {
        if (actorSyncRegistry[i].actorId == actorId) {
            return &actorSyncRegistry[i];
        }
    }
    return NULL;
}

static int GetActionFuncIndex(ActorSyncInfo* info, void* funcPtr) {
    if (info == NULL || info->actionFuncTable == NULL) return -1;
    for (int i = 0; i < info->actionFuncCount; i++) {
        if (info->actionFuncTable[i] == funcPtr) return i;
    }
    return -1;
}

static void* GetActionFuncByIndex(ActorSyncInfo* info, int index) {
    if (info == NULL || info->actionFuncTable == NULL) return NULL;
    if (index < 0 || index >= info->actionFuncCount) return NULL;
    return info->actionFuncTable[index];
}

